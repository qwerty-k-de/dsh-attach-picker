{
  "name": "dsh-attach-picker",
  "version": "0.1.0",
  "description": "DSH Web 输入框工具栏图片按钮：点击用系统文件选择器挑图片，不用拖拽。Toolbar button that opens the OS file picker to attach images to the DSH Web composer — no drag-and-drop needed.",
  "type": "module",
  "license": "MIT",
  "author": "qwerty-k-de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwerty-k-de/dsh-attach-picker.git"
  },
  "homepage": "https://github.com/qwerty-k-de/dsh-attach-picker#readme",
  "bugs": {
    "url": "https://github.com/qwerty-k-de/dsh-attach-picker/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "plugin",
    "attach",
    "attachment",
    "image",
    "upload",
    "picker",
    "web-ui"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  }
}
